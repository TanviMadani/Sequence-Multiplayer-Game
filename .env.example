# PORT: which port the Express + Socket.IO server listens on.
# Most hosting platforms (Render, Railway, Fly.io) inject this automatically —
# only set it yourself for local/manual deployments.
PORT=3000

# CORS_ORIGIN: origin allowed to open a Socket.IO connection to this server.
# Leave unset (or "*") if the frontend is served from this same server
# (the default setup). Set it to your frontend's URL if you ever split
# frontend and backend into separate deployments.
CORS_ORIGIN=*
